VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_PRIVATE_KEY=your_private_key_here
VITE_CONTACT_RECIPIENT_EMAIL=your_email@example.com

# --- AUVD newsletter (Resend) ---
# Server-side only. Never prefix these with VITE_: a VITE_ variable is bundled
# into the JavaScript every visitor downloads, which would leak the API key.
# RESEND_API_KEY is kept in .env.local, which .gitignore already excludes.
RESEND_API_KEY=re_your-real-key-here
RESEND_FROM=AUVD News <news@yourdomain.org>
SITE_URL=https://yourdomain.org

# The single-admin backend (MongoDB + JWT) is configured separately — see
# .env.local.example in this folder.
