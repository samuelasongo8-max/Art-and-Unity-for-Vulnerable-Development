# ==========================================================================
#  TEMPLATE — copy this file to .env.local and fill in the real values.
#
#      copy .env.local.example .env.local      (Windows: copy .env.local.example .env.local)
#
#  .env.local is already ignored by .gitignore, so nothing you type into it
#  is ever committed. This template is safe to commit because it holds only
#  placeholder values.
#
#  NEVER prefix any of these with VITE_. A VITE_ variable is bundled into the
#  JavaScript every visitor downloads, which would publish the secret to the
#  whole internet.
# ==========================================================================


# --------------------------------------------------------------------------
#  ON VERCEL (Production) — set these THREE, and nothing else:
#
#    MONGODB_URI
#    JWT_SECRET
#    JWT_EXPIRES_IN
#
#  ADMIN_EMAIL and ADMIN_PASSWORD below are for the LOCAL seed script ONLY.
#  No deployed route ever reads them, so they must NOT be set in Vercel.
# --------------------------------------------------------------------------

# Connection string for your MongoDB database (Atlas or self-hosted).
MONGODB_URI=

# Secret used to sign the admin session cookie. Generate a fresh random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anyone who knows this can forge a session, so never commit it and never reuse
# it anywhere else. Rotating it logs every admin session out.
JWT_SECRET=

# How long a login lasts before the admin is asked to sign in again, in
# jsonwebtoken shorthand: 30m, 12h, 7d, ...
JWT_EXPIRES_IN=7d


# --------------------------------------------------------------------------
#  LOCAL DEVELOPMENT ONLY
# --------------------------------------------------------------------------

# The port the local Express API server (server/index.js) listens on. It must
# match the dev proxy target in vite.config.js, which is how
# http://localhost:5173/api/... reaches the real Vercel handler files.
# The Vite frontend itself runs on 5173.
PORT=5000


# --------------------------------------------------------------------------
#  LOCAL SEED SCRIPT ONLY — never set these in Vercel.
#
#  Read exclusively by scripts/create-admin.mjs, which creates the ONE admin
#  account. The password is hashed with bcrypt (cost 12) before it is stored;
#  the plain value is never written to the database and never logged.
# --------------------------------------------------------------------------

# The admin's email address. This is the only address that can ever sign in.
ADMIN_EMAIL=your-admin-email@example.org

# The admin's password. Use at least 12 characters; the script refuses anything
# shorter. To change it later, edit this and run: npm run admin:reset
ADMIN_PASSWORD=your-admin-password-here


# ==========================================================================
#  THE ORDER TO DO THINGS IN
#
#    1. Fill in this file and save it as .env.local
#    2. npm run admin:create      -> creates the one admin account
#    3. npm run moments:migrate   -> moves the existing feed posts into MongoDB
#    4. Add the three Vercel variables above, for Production, then redeploy
# ==========================================================================