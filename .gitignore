# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Email previews written by "npm run news:dry-run". They are build output,
# not source, and can contain unpublished wording.
email-previews/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
# Real secrets never belong in the repo. .env.local (the file the seed scripts
# read), .env.production.local and .env.vercel are all caught by this rule.
.env*
# ...but the blank TEMPLATE is meant to be committed, so it is exempted. Without
# this line ".env*" would match ".env.local.example" too and the template would
# be impossible to share.
!.env.example
!.env.local.example

# Local verification files
.shots/
.verify-about/

# Backend dependencies
backends/node_modules/
